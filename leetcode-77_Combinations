import java.util.*;

class Solution {
    List<List<Integer>> result = new ArrayList<>();

    public List<List<Integer>> combine(int n, int k) {
        solve(1, n, k, new ArrayList<>());
        return result;
    }

    private void solve(int num, int n, int k, List<Integer> curr) {

        if (curr.size() == k) {
            result.add(new ArrayList<>(curr));
            return;
        }

        if (num > n) return;

        
        curr.add(num);
        solve(num + 1, n, k, curr);
        curr.remove(curr.size() - 1);

        
        solve(num + 1, n, k, curr);
    }
}
